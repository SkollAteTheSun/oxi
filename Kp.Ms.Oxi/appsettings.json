{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "NLog": {
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "encoding": "utf-8",
        "layout": "${machinename} - ${longdate} [${threadID}] ${uppercase:${level}} ${logger} - ${message} ${exception:format=tostring}"
      },
      "file": {
        "type": "File",
        "encoding": "utf-8",
        "fileName": "logs/Log.log",
        "archiveFileName": "logs/archive/{#}.zip",
        "layout": "${machinename} - ${longdate} [${threadID}] ${uppercase:${level}} ${logger} - ${message} ${exception:format=tostring}",
        "archiveNumbering": "DateAndSequence",
        "archiveAboveSize": "52428800",
        "archiveEvery": "Day",
        "maxArchiveDays": "30",
        "enableArchiveFileCompression": true
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console,file"
      }
    ]
  },
  "Cors": {
    "Urls": [
      "*"
    ]
  },
  "ConnectionStrings": {
    "Booking": "server = server;database = database;user = user;password = password;",
    "Db": "Server=localhost;Port=5432;Database=database;User Id=postgres;Password=password"
  },
  "BookingApi": {
    "BaseUrl": "",
    "Token": "",
    "TransactionGetResponseUrl": "/transactions/get_response"
  },
  "DirectMode": false,
